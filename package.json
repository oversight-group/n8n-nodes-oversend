{
  "name": "n8n-nodes-oversend",
  "version": "0.1.0",
  "description": "n8n community node for OverSend: WhatsApp messages to people and groups, templates, chats, notes, scheduled messages, unsubscribes and a webhook trigger",
  "keywords": ["n8n-community-node-package", "n8n", "oversend", "whatsapp", "whatsapp-groups"],
  "license": "MIT",
  "author": { "name": "Rotem Abergel", "email": "rotem@oversight.co.il" },
  "homepage": "https://github.com/oversight-group/n8n-nodes-oversend#readme",
  "bugs": { "url": "https://github.com/oversight-group/n8n-nodes-oversend/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/oversight-group/n8n-nodes-oversend.git" },
  "engines": { "node": ">=20.15" },
  "main": "index.js",
  "files": ["dist"],
  "scripts": {
    "build": "rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "format": "prettier nodes credentials test --write",
    "test": "jest",
    "icons": "node scripts/make-icons.mjs",
    "smoke": "node --env-file=.env scripts/smoke.mjs",
    "scan": "node scripts/scan.mjs",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": ["dist/credentials/OverSendApi.credentials.js"],
    "nodes": ["dist/nodes/OverSend/OverSend.node.js", "dist/nodes/OverSendTrigger/OverSendTrigger.node.js"]
  },
  "peerDependencies": { "n8n-workflow": "*" },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^5.0.0",
    "jest": "^29.7.0",
    "n8n-workflow": "*",
    "prettier": "^3.3.0",
    "rimraf": "^5.0.7",
    "ts-jest": "^29.1.4",
    "typescript": "^5.5.0"
  }
}
